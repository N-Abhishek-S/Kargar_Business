{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$1"
        }
      ]
    }
  ]
}
