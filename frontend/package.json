{
  "name": "kargar-fm-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx --tsconfig scripts/tsconfig.seo.json scripts/seo/index.ts",
    "build": "tsc -b && vite build",
    "postbuild": "tsx --tsconfig scripts/tsconfig.seo.json scripts/seo/postbuild.ts",
    "seo": "tsx --tsconfig scripts/tsconfig.seo.json scripts/seo/index.ts",
    "lint": "eslint src/",
    "type-check": "tsc -b",
    "format": "prettier --write src/",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@gsap/react": "^2.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.1",
    "gsap": "^3.12.7",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.1",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-intersection-observer": "^9.15.1",
    "react-router": "^7.1.5",
    "swiper": "^11.2.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "playwright": "^1.50.1",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0"
  }
}
